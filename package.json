{
  "name": "vera-ai",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "update-types": "pnpm dlx supabase@2.90.0 gen types typescript --project-id \"trwryhotfqkcvwulmate\" --schema public > types/supabase.ts",
    "db:apply": "node scripts/run-linked-sql.mjs",
    "db:apply:billing-plan-v2": "pnpm db:apply db/billing-plan-v2.sql",
    "db:apply:knowledge-base-phase2": "pnpm db:apply db/knowledge-base-phase2.sql",
    "db:backfill:knowledge-base-summaries": "node scripts/backfill-kb-summaries.mjs",
    "db:apply-and-types": "pnpm db:apply && pnpm update-types",
    "db:refresh-types": "pnpm update-types"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.159",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@react-pdf/renderer": "^4.4.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "ai": "^6.0.156",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^0.0.15",
